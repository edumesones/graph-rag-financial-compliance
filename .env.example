# ================================
# Fintech Agentic RAG - Environment Variables
# ================================
# Copy this file to .env and fill in your credentials
# cp .env.example .env

# ================================
# Application Settings
# ================================
ENVIRONMENT=production

# ================================
# Hugging Face
# ================================
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# ================================
# SEC EDGAR Ingestion
# ================================
# SEC requires a User-Agent identifying the requester for EDGAR downloads.
# Requests without a real contact are throttled or blocked.
SEC_USER_AGENT=Your Name your.email@example.com

# ================================
# LLM Configuration
# ================================
# LLM model for reasoning (HuggingFace Inference API or OpenAI)
LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct

# Embedding model for semantic search
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# OpenAI API (optional - only if using OpenAI models)
OPENAI_API_KEY=

# ================================
# Neo4j Database
# ================================
# Set a strong password for Neo4j
NEO4J_PASSWORD=your_strong_neo4j_password_here

# These are set automatically by docker-compose
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ================================
# PostgreSQL Database
# ================================
# Set a strong password for PostgreSQL
POSTGRES_PASSWORD=your_strong_postgres_password_here

# These are set automatically by docker-compose
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=fintech_rag
POSTGRES_USER=fintech_user

# ================================
# Redis Cache
# ================================
# Cache TTL in seconds (default: 1 hour)
REDIS_CACHE_TTL=3600

# These are set automatically by docker-compose
REDIS_HOST=redis
REDIS_PORT=6379

# ================================
# Grafana
# ================================
# Set a strong password for Grafana admin
GRAFANA_PASSWORD=your_strong_grafana_password_here

# ================================
# PgAdmin (Optional)
# ================================
# Only used if you start with: docker-compose --profile full up
PGADMIN_EMAIL=admin@fintech-rag.local
PGADMIN_PASSWORD=your_strong_pgadmin_password_here

# ================================
# LangSmith Observability (Optional)
# ================================
# Enable LangSmith tracing for debugging
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fintech-agentic-rag-docker

# ================================
# Security Notes
# ================================
# 1. NEVER commit .env file to git
# 2. Use strong, unique passwords for each service
# 3. Rotate credentials regularly in production
# 4. Keep HUGGINGFACE_TOKEN and API keys secure
